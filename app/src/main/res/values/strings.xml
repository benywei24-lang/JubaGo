    <!-- Onboarding Step 0: Welcome -->
    <string name="onboarding_welcome_title">Welcome to JubaGo</string>
    <string name="onboarding_welcome_desc">The unified commerce, booking, and delivery network tailored for Juba, Greater Equatoria, and beyond. Explore restaurants, book hotels, hail transport, and connect directly with verified merchants.</string>
    <string name="onboarding_core_services_title">Core Services at Your Fingertips:</string>
    <string name="onboarding_feature_food_title">Food &amp; Nile Cuisine Delivery</string>
    <string name="onboarding_feature_food_desc">Hot meals from Juba\'s best kitchens (Nile King, Da Vinci, Nimule Kitchen) delivered directly to your home or office.</string>
    <string name="onboarding_feature_hotel_title">Hotels &amp; Riverside Accommodations</string>
    <string name="onboarding_feature_hotel_desc">Instant reservations for luxury suites, Nile views, and budget-friendly guest houses with transparent rates.</string>
    <string name="onboarding_feature_transport_title">Boda Boda &amp; Car Rental Logistics</string>
    <string name="onboarding_feature_transport_desc">Book vetted drivers, airport pickups to JIA, and express courier dispatch across all major roads.</string>
    <string name="onboarding_feature_cargo_title">Domestic Air &amp; Regional Cargo</string>
    <string name="onboarding_feature_cargo_desc">Connect flights between Juba, Wau, Malakal, and cross-border transport across East Africa.</string>
    <string name="onboarding_local_advantage_header">Built Specifically for Local Reality</string>
    <string name="onboarding_local_advantage_map">Offline Nile Map</string>
    <string name="onboarding_local_advantage_battery">Battery Saver</string>
    <string name="onboarding_local_advantage_payments">m-GURUSH / MoMo</string>

    <!-- Onboarding Step 1: Discovery Tutorial -->
    <string name="onboarding_discovery_title">Step 1: Finding What You Need</string>
    <string name="onboarding_discovery_desc">JubaGo makes it simple to discover businesses across South Sudan, even when internet connections fluctuate.</string>
    <string name="onboarding_discovery_tip1_title">Contextual Search Bar</string>
    <string name="onboarding_discovery_tip1_desc">Search by vendor name, meal type (e.g., \'Fresh Nile Perch\'), neighborhood (\'Hai Cinema\', \'Munuki\'), or keyword.</string>
    <string name="onboarding_discovery_tip2_title">Geographic Scope Filter</string>
    <string name="onboarding_discovery_tip2_desc">Toggle between Central Juba, Greater Equatoria, All South Sudan States, and Regional East Africa.</string>
    <string name="onboarding_discovery_tip3_title">Offline Map Tile Mode</string>
    <string name="onboarding_discovery_tip3_desc">Tap the Wi-Fi icon on the home screen to access cached maps and saved provider contacts without data.</string>
    <string name="onboarding_discovery_practice_title">Interactive Practice: Try Filtering Below</string>

    <!-- Onboarding Step 2: Booking Tutorial -->
    <string name="onboarding_booking_title">Step 2: 3-Step Fast Booking</string>
    <string name="onboarding_booking_desc">Ordering meals, scheduling transport, or booking rooms takes less than 30 seconds.</string>
    <string name="onboarding_booking_step1_title">Tap \'Book Now\' or \'Quick Order\'</string>
    <string name="onboarding_booking_step1_desc">Choose your item directly from the list or service details screen.</string>
    <string name="onboarding_booking_step2_title">Confirm Contact &amp; Delivery Address</string>
    <string name="onboarding_booking_step2_desc">Provide your phone number and landmark (e.g. Near Tongping Church, Juba).</string>
    <string name="onboarding_booking_step3_title">Select Payment &amp; Confirm</string>
    <string name="onboarding_booking_step3_desc">Choose m-GURUSH, Eden Mobile, MTN MoMo, or Cash on Delivery.</string>
    <string name="onboarding_booking_practice_title">Interactive Practice: Try a Demo Payment Choice</string>
    <string name="onboarding_demo_success_title">🎉 Success! Order #JB-DEMO Placed</string>
    <string name="onboarding_demo_success_desc">You will instantly receive an SMS confirmation, live GPS tracking coordinates, and status notifications.</string>

    <!-- Onboarding Step 3: Live Tracking -->
    <string name="onboarding_tracking_title">Step 3: Real-Time Tracking &amp; Support</string>
    <string name="onboarding_tracking_desc">Never wonder where your parcel, ride, or order is. JubaGo provides live position updates and instant messaging.</string>
    <string name="onboarding_tracking_tip1_title">Live Nile Map Tracker</string>
    <string name="onboarding_tracking_tip1_desc">Track couriers moving along Nile bridges, Airport Road, and Custom market in real time with estimated arrival times.</string>
    <string name="onboarding_tracking_tip2_title">Real-Time Sync Indicators</string>
    <string name="onboarding_tracking_tip2_desc">Monitor our smart indicator: 🟢 Online (live cloud updates), 🔵 Syncing (transmitting), or 🟠 Offline (queued safely on device).</string>
    <string name="onboarding_tracking_tip3_title">24/7 Nile Concierge &amp; Support</string>
    <string name="onboarding_tracking_tip3_desc">Tap the \'Support Chat\' tab anytime to message our friendly local team for booking help, changes, or directions.</string>

    <!-- Onboarding Step 4: Final Step -->
    <string name="onboarding_final_title">You\'re All Set!</string>
    <string name="onboarding_final_desc">Whether you want to order food, book a room, hire a driver, or expand your business across South Sudan, JubaGo is your trusted partner.</string>
